# MAKDO environment variables
# Copy to .env (in this makdo directory) and fill in the values you need.

# --- LLM -------------------------------------------------------------------
# OpenAI (default):
OPENAI_API_KEY=sk-your-openai-api-key
MAKDO_MODEL=gpt-4o

# Ollama (or any other OpenAI-compatible server) - use these three lines instead:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MAKDO_MODEL=llama3.1:8b

# --- k8s-ai A2A server (../k8s-ai) ----------------------------------------
K8S_AI_BASE_URL=http://localhost:9999
K8S_AI_ADMIN_URL=http://localhost:9998
# Must match the key the server was started with: uv run k8s-ai-server --auth-key test-key
K8S_AI_API_KEY=test-key

# Kube context of the cluster MAKDO monitors
MAKDO_CLUSTER_CONTEXT=kind-makdo-test

# Seconds between health checks (default: monitoring.check_interval in config/makdo.yaml)
# MAKDO_CHECK_INTERVAL=60

# --- Slack (optional) -------------------------------------------------------
# Bot token (xoxb-...) of a Slack app with the chat:write and channels:read scopes.
# Without it MAKDO still runs; the Slack Bot agent just reports that Slack is not configured.
AI6_BOT_TOKEN=
