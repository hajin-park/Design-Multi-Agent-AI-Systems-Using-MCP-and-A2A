# Copy to py/.env and fill in the values you need. All AI-6 frontends load it.

# OpenAI (only needed if your config uses an OpenAI model such as gpt-4o)
OPENAI_API_KEY=sk-your-openai-api-key

# Ollama (optional; defaults to http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Slack frontend only (see frontend/slack/README.md)
AI6_BOT_TOKEN=xoxb-your-slack-bot-token
AI6_APP_TOKEN=xapp-your-slack-app-token
