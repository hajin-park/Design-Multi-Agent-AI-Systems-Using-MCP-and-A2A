# Values for ./create-secrets.sh - copy to .env and fill in.

# Shared secret between MAKDO and the k8s-ai A2A server (any string you choose)
K8S_AI_API_KEY=test-key

# --- LLM used by the MAKDO agents ------------------------------------------
# OpenAI:
OPENAI_API_KEY=sk-your-openai-api-key
MAKDO_MODEL=gpt-4o

# Ollama running on your machine - use these three lines instead.
# Pods reach the host through host.docker.internal (Docker Desktop).
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# MAKDO_MODEL=llama3.1:8b

# --- Slack (optional) ---------------------------------------------------------
# Bot token (xoxb-...) with the chat:write and channels:read scopes
AI6_BOT_TOKEN=
